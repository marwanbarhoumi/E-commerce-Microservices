# ============================================================
#  AUTH SERVICE — Dockerfile
#  هذا الملف يحوّل السيرفر لـ Container
#  مثل "صندوق" فيه كل شيء يحتاجه البرنامج يشتغل
# ============================================================

# ── الخطوة 1: الصورة الأساسية ────────────────────────────────
# نبدأو من صورة Node.js رسمية
# alpine = نسخة خفيفة جداً من Linux (حجم أصغر)
FROM node:20-alpine

# ── الخطوة 2: مجلد العمل داخل الـ Container ─────────────────
# كل الملفات راه تتحط في /app
WORKDIR /app

# ── الخطوة 3: نسخ ملفات المكتبات أولاً ──────────────────────
# نسخ package.json قبل باقي الملفات
# السبب: Docker يحفظ هذه الخطوة في الـ cache
# لو ما تغيّرش package.json → ما يعيدش تحميل المكتبات في كل مرة
COPY package*.json ./

# ── الخطوة 4: تثبيت المكتبات ─────────────────────────────────
# --omit=dev → ما نثبّتوش مكتبات التطوير في الـ production
RUN npm install --omit=dev

# ── الخطوة 5: نسخ باقي الملفات ───────────────────────────────
# ننسخوا كل الكود للـ container
COPY . .

# ── الخطوة 6: البورت ─────────────────────────────────────────
# نخبّروا Docker إن السيرفر يشتغل على هذا البورت
# هذا للتوثيق بس — الربط الفعلي يصير في docker-compose.yml
EXPOSE 3001

# ── الخطوة 7: الأمر عند التشغيل ─────────────────────────────
# هذا الأمر يشتغل لما نبدأوا الـ container
CMD ["node", "src/index.js"]

# ============================================================
#  كيف Docker يبني هذا الملف:
#
#  docker build -t auth-service .
#
#  النتيجة: صورة (image) جاهزة
#  نشغّلوها: docker run -p 3001:3001 auth-service
# ============================================================